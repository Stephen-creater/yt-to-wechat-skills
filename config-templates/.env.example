# =============================================================================
# 把这个文件复制成 .env，填入你自己的密钥
#
# 推荐放在：
#   - 项目级（优先）：<你的内容项目根目录>/.ds-skills/.env
#   - 用户级（兜底）：~/.ds-skills/.env
#
# 两个位置都有时，项目级优先生效。
# =============================================================================

# -----------------------------------------------------------------------------
# 微信公众号 API（必填，用于 ds-post-to-wechat 发布）
#
# 申请：登录 mp.weixin.qq.com →「开发」→「基本配置」
# - AppID：直接复制
# - AppSecret：点「重置」生成，只显示一次，立刻存好
#
# 另外：同一页面的「IP 白名单」要加入你发布机器的公网 IP，否则会报 40164
# -----------------------------------------------------------------------------
WECHAT_APP_ID=wxXXXXXXXXXXXXXXXX
WECHAT_APP_SECRET=请填入你的_AppSecret_32位字符串

# -----------------------------------------------------------------------------
# OpenAI 兼容图片 API（用于 ds-cover-image / ds-imagine 生成封面）
#
# 三选一：
#   1) OpenAI 官方         OPENAI_API_KEY=sk-...        OPENAI_BASE_URL=https://api.openai.com/v1
#   2) Azure OpenAI        AZURE_OPENAI_API_KEY=...     另外配 AZURE_OPENAI_DEPLOYMENT
#   3) OpenAI 兼容中转站   OPENAI_API_KEY=...           OPENAI_BASE_URL=<中转站 v1 地址>
#
# 模型：gpt-image-2 对中文标题渲染最稳；若 key 不支持，可改成 dashscope/seedream/jimeng
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-请填入你的_OpenAI_API_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2

# -----------------------------------------------------------------------------
# 可选：其它图片提供商（按需开启，留空就跳过）
# -----------------------------------------------------------------------------
# DASHSCOPE_API_KEY=
# ARK_API_KEY=              # 火山引擎豆包 Seedream
# JIMENG_ACCESS_KEY_ID=     # 火山引擎即梦
# JIMENG_SECRET_ACCESS_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
